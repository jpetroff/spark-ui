{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2023.Array", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/components/ui/*": ["./packages/*/src/react.tsx"],
      "@/lib/spark-utils": ["./packages/utils/src/spark-utils.ts"],
      "@spark/async-list/*": ["./packages/async-list/src/*"],
      "@spark/button/*": ["./packages/button/src/*"],
      "@spark/checkbox/*": ["./packages/checkbox/src/*"],
      "@spark/collapsible/*": ["./packages/collapsible/src/*"],
      "@spark/collection/*": ["./packages/collection/src/*"],
      "@spark/date-picker/*": ["./packages/date-picker/src/*"],
      "@spark/dialog/*": ["./packages/dialog/src/*"],
      "@spark/environment/*": ["./packages/environment/src/*"],
      "@spark/field/*": ["./packages/field/src/*"],
      "@spark/fieldset/*": ["./packages/fieldset/src/*"],
      "@spark/floating-panel/*": ["./packages/floating-panel/src/*"],
      "@spark/format/*": ["./packages/format/src/*"],
      "@spark/highlight/*": ["./packages/highlight/src/*"],
      "@spark/hover-card/*": ["./packages/hover-card/src/*"],
      "@spark/json-tree-view/*": ["./packages/json-tree-view/src/*"],
      "@spark/locale/*": ["./packages/locale/src/*"],
      "@spark/menu/*": ["./packages/menu/src/*"],
      "@spark/number-input/*": ["./packages/number-input/src/*"],
      "@spark/popover/*": ["./packages/popover/src/*"],
      "@spark/portal/*": ["./packages/portal/src/*"],
      "@spark/presence/*": ["./packages/presence/src/*"],
      "@spark/radio-group/*": ["./packages/radio-group/src/*"],
      "@spark/scroll-area/*": ["./packages/scroll-area/src/*"],
      "@spark/segment-group/*": ["./packages/segment-group/src/*"],
      "@spark/select/*": ["./packages/select/src/*"],
      "@spark/shared/*": ["./packages/shared/src/*"],
      "@spark/styles/*": ["./packages/styles/src/*"],
      "@spark/swap/*": ["./packages/swap/src/*"],
      "@spark/switch/*": ["./packages/switch/src/*"],
      "@spark/tabs/*": ["./packages/tabs/src/*"],
      "@spark/toast/*": ["./packages/toast/src/*"],
      "@spark/toggle/*": ["./packages/toggle/src/*"],
      "@spark/tree-view/*": ["./packages/tree-view/src/*"],
      "@spark/utils/*": ["./packages/utils/src/*"]
    }
  },
  "include": [
    "src",
    "src/**/*.css",
    "packages/button/src/react.tsx",
    "packages/*/src/*.stories.tsx",
    "packages/utils",
    ".storybook",
    "vite.config.ts"
  ]
}
