{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client", "node"]
  },
  "include": [
    "packages/*/src/common/**/*.ts",
    "packages/*/src/react/**/*",
    "packages/*/src/react.tsx"
  ]
}
