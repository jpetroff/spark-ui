{
  "name": "spark-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.16.1 <13"
  },
  "scripts": {
    "dev": "pnpm registry:build && vite",
    "build": "pnpm typecheck && pnpm registry:build && vite build",
    "preview": "vite preview",
    "storybook": "pnpm registry:build && storybook dev -p 6006",
    "storybook:build": "pnpm registry:build && storybook build",
    "registry:build": "shadcn build && node scripts/vendor/import.ts registry",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck && pnpm typecheck:vendor && pnpm typecheck:importer",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm aliases:check && pnpm typecheck && pnpm format:check",
    "aliases:sync": "node scripts/vendor/aliases.ts sync",
    "aliases:check": "node scripts/vendor/aliases.ts check",
    "vendor:import": "node scripts/vendor/command.ts",
    "verify-imports": "node scripts/vendor/import.ts verify",
    "test:importer": "node --test scripts/vendor/*.test.ts",
    "typecheck:vendor": "tsc -p tsconfig.vendor-react.json && node packages/vendor-tools/node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.vendor-svelte.json",
    "test:registry": "node scripts/vendor/smoke.ts",
    "test:browser": "node scripts/vendor/browser.ts",
    "typecheck:importer": "node node_modules/typescript-parser/bin/tsc -p tsconfig.importer.json"
  },
  "devDependencies": {
    "@floating-ui/dom": "1.7.6",
    "@internationalized/date": "3.12.4",
    "@playwright/test": "1.61.1",
    "@spark-ui/utils": "workspace:*",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.2",
    "csstype": "3.2.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.7.4",
    "shadcn": "4.23.0",
    "shadcn-svelte": "1.7.2",
    "storybook": "10.6.5",
    "svelte": "5.57.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-parser": "npm:typescript@6.0.3",
    "vite": "8.3.5"
  }
}
